# TravelMate – Explore the World Configuration
# Optional: If you leave these blank, TravelMate will seamlessly operate in local demo mode using localStorage.

# Supabase Credentials (Optional - for cloud persistence)
# Find these in your Supabase Project Settings -> API
VITE_SUPABASE_URL=https://your-supabase-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# Google Gemini API Key (Optional - for live generative AI travel planner)
# If omitted, TravelMate uses the built-in intelligent rule-based itinerary synthesis engine
VITE_GEMINI_API_KEY=
